# OpenAI-compatible model settings. Leave LOCAL_AGENT_API_KEY empty to use extractive fallback.
LOCAL_AGENT_API_KEY=
LOCAL_AGENT_BASE_URL=https://api.openai.com/v1
LOCAL_AGENT_MODEL=gpt-4.1-mini

# Docker/default service settings.
LOCAL_AGENT_PROJECT=/project
LOCAL_AGENT_CONFIG=/project/runtime.toml
LOCAL_AGENT_PORT=8765

# Configure HTTP auth in runtime.toml [server]; mirror the intended token here for deployment tooling.
LOCAL_AGENT_SERVER_AUTH_TOKEN=
